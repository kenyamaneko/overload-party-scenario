# overload-party-scenario environment variables

# PostgreSQL connection string (libpq keyword form) for the `scenario` schema (required).
DATABASE_CONN=host=localhost port=5432 dbname=scenario user=scenario password=scenario sslmode=disable

# Story script source (required).
# Production: GCS bucket name
STORY_BUCKET=op-scenario-scripts-prod
# OR local development (filesystem path after the "local:" prefix)
# STORY_BUCKET=local:./testdata/stories

# Pub/Sub Google Cloud project (required).
PUBSUB_PROJECT_ID=scenario-local

# Pub/Sub topic names (required; 物理 topic 名は infra/Terraform が SSoT、アプリは env で解決).
ONBOARDING_NAME_SET_TOPIC=onboarding-name-set
ONBOARDING_FACTION_SET_TOPIC=onboarding-faction-set
PLAYER_ONBOARDED_TOPIC=player-onboarded

# Firestore Google Cloud project (required; game_config 読み取り用).
FIRESTORE_PROJECT_ID=scenario-local

# Account service base URL (required; onboarding 内 name 確定と再開判定で scenario が直叩きする先).
# ClusterIP DNS (例: http://account.<ns>.svc.cluster.local:9000) を本番想定。
ACCOUNT_BASE_URL=http://localhost:9001

# Listen port (default 9007).
PORT=9007

# Environment name (dev / stg / prod).
ENV=dev
